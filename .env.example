# Optional settings. The app runs with none of these set.
# Copy to .env.local to change them. Never commit real values.

# Where the local SQLite database file is stored (default: ./data/phoniex.db)
# DATABASE_PATH=./data/phoniex.db

# Where new leads and project requests are emailed.
# SALES_INBOX_EMAIL=sales@yourcompany.com

# Optional: send real emails through Resend (resend.com). A send-only key is enough.
# Without it, emails are only saved to the outbox on the admin page.
# RESEND_API_KEY=
# Must use a domain verified in Resend (e.g. "PHONIEX <hello@yourdomain.com>").
# Until then only onboarding@resend.dev works, and only to your Resend account email.
# EMAIL_FROM=PHONIEX <onboarding@resend.dev>

# Optional: connect Claude to turn on real AI replies (agents, listing agent,
# renovation suggestions). Without either key, agents run in labelled demo mode.
# Option A — direct Anthropic key:
# ANTHROPIC_API_KEY=
# Option B — Vercel AI Gateway key (starts with vck_):
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=anthropic/claude-sonnet-5.5   # optional: force one model

# ---- Partnership appointment agent (Contact us page) ----
# Booking page sent to partners who reply YES (name and email are prefilled).
# CALENDLY_URL=https://calendly.com/mohammadalblooshi1
# Public site address used in email links (Vercel sets its own address automatically).
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Protects the daily job that sends follow-ups and thank-you letters (Vercel Cron sends it).
# CRON_SECRET=
# Optional: let partners answer by replying to the email (needs an inbound email service).
# PARTNER_REPLY_TO=partners@your-domain.com
# INBOUND_EMAIL_SECRET=
# Optional: Calendly webhook signing key, so the thank-you letter is sent automatically after the meeting.
# CALENDLY_WEBHOOK_SIGNING_KEY=
